@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "CLI and navigation" {
  class Main
  class MenuRouter
  abstract class MenuView
  class RegisterMenuView
  class LoginMenuView
  class CommonMenuView
  class GameMenuView
  class PlantSelectionView
  class GameplayView
  class TravelMenuView
  class MiniGameMenu
  class ScoredGameView
  enum Command
  enum MenuName
  class Result<T>

  Main --> MenuRouter : routes input
  MenuRouter o-- MenuView : owns menu views
  MenuView <|-- RegisterMenuView
  MenuView <|-- LoginMenuView
  MenuView <|-- CommonMenuView
  MenuView <|-- GameMenuView
  MenuView <|-- PlantSelectionView
  MenuView <|-- GameplayView
  MenuView <|-- TravelMenuView
  MenuView <|-- MiniGameMenu
  MenuView <|-- ScoredGameView
  MenuRouter --> MenuName
  MenuView ..> Command : regex matching
  MenuView ..> Result : prints
}

package "Composition root and controllers" {
  class App
  class MenuController
  class RegisterMenuController
  class LoginMenuController
  class MainMenuController
  class GameMenuController
  class CollectionMenuController
  class PlantSelectionController
  class GameplayController
  class BoardController
  class GreenhouseController
  class ShopController
  class TravelMenuController
  class MiniGameController
  class ScoredGameController

  App *-- MenuController
  App *-- RegisterMenuController
  App *-- LoginMenuController
  App *-- MainMenuController
  App *-- GameMenuController
  App *-- CollectionMenuController
  App *-- PlantSelectionController
  App *-- GreenhouseController
  App *-- ShopController
  App *-- TravelMenuController
  App *-- MiniGameController
  App *-- ScoredGameController
  MenuRouter --> App
  GameMenuView --> GameMenuController
  GameMenuView --> PlantSelectionController : starts resolved level
  PlantSelectionView --> PlantSelectionController
  GameplayView --> GameplayController
  GameplayController *-- BoardController
  TravelMenuView --> TravelMenuController
  MiniGameMenu --> MiniGameController
  ScoredGameView --> ScoredGameController
}

package "Users, persistence, and cross-cutting services" {
  class User
  class Collection
  class PlantCard
  class MiniGameProgress
  class QuestProgress
  class DailyShopState
  class News
  interface UserRepository
  class JsonUserRepository
  class UserService
  class SaveFile
  class SaveFileMigrator
  interface SaveSerializer
  class GsonSaveSerializer
  class AtomicFileWriter
  interface PasswordService
  class Sha256PasswordService
  class NewsService
  class LeaderboardService
  class GameConclusionService

  User *-- Collection
  Collection *-- PlantCard
  User *-- MiniGameProgress
  User *-- QuestProgress
  User *-- DailyShopState
  User *-- News
  UserRepository <|.. JsonUserRepository
  JsonUserRepository --> SaveFile
  JsonUserRepository *-- SaveFileMigrator
  JsonUserRepository *-- SaveSerializer
  SaveSerializer <|.. GsonSaveSerializer
  JsonUserRepository *-- AtomicFileWriter
  UserService *-- UserRepository
  PasswordService <|.. Sha256PasswordService
  RegisterMenuController --> PasswordService
  LoginMenuController --> PasswordService
  App *-- UserService
  App *-- NewsService
  App *-- LeaderboardService
  App *-- GameConclusionService
}

package "Adventure and deterministic simulation" {
  interface Level
  class NormalLevel
  class SpecialLevel
  class BossLevel
  enum SpecialLevelType
  class LevelSelectionRules
  class AdventureCatalog
  class ChapterCatalog
  class AdventureLevelConfig
  class GameSession
  class PlantSelection
  class Simulation
  interface SimulationSystem
  class SimulationWorld
  class Board
  class Tile
  class AdventureInitializer
  class AdventureRuleSystem
  class WaveSystem
  class CooldownSystem
  class FallingSunSystem
  class ZombieCombatSystem
  class ZombieSpecialSystem

  Level <|.. NormalLevel
  Level <|.. SpecialLevel
  Level <|.. BossLevel
  SpecialLevel --> SpecialLevelType
  Level *-- LevelSelectionRules
  AdventureCatalog o-- Level
  ChapterCatalog ..> Level : unlock progression
  Level --> AdventureLevelConfig
  GameSession *-- Level
  GameSession *-- PlantSelection
  PlantSelectionController --> GameSession
  PlantSelectionController --> AdventureInitializer
  PlantSelectionController --> Simulation
  Simulation *-- SimulationWorld
  SimulationWorld *-- Board
  Board *-- Tile
  Simulation o-- SimulationSystem
  SimulationSystem <|.. AdventureRuleSystem
  SimulationSystem <|.. WaveSystem
  SimulationSystem <|.. CooldownSystem
  SimulationSystem <|.. FallingSunSystem
  SimulationSystem <|.. ZombieCombatSystem
  SimulationSystem <|.. ZombieSpecialSystem
  BossLevel ..> GameConclusionService : deferred to Phase 2
}

package "Plants and zombies" {
  interface PlantRepository
  class PlantRegistry
  class PlantDefinition
  interface PlantBehavior
  class PlantBehaviorFactory
  class BonusPlantBehavior <<bonus>>
  class PlantInstance
  interface PlantSpecSource
  class DefaultPlantSpecSource
  interface ZombieRepository
  class ZombieRegistry
  class ZombieDefinition
  class ZombieFactory
  class ZombieBehaviorFactory
  class CompositeZombieBehavior
  class ZombieInstance
  interface ZombieAttackComponent
  interface ZombieMovementComponent
  interface ZombieSpecialAbility
  class ArmoredRamZombieAttack <<bonus>>
  class FishermanAbility <<bonus>>
  class JesterAbility <<bonus>>
  class WizardAbility <<bonus>>
  class KingAbility <<bonus>>
  interface ZombieSpecSource
  class DefaultZombieSpecSource

  PlantRepository <|.. PlantRegistry
  PlantRegistry o-- PlantDefinition
  PlantBehaviorFactory o-- PlantBehavior
  PlantBehavior <|.. BonusPlantBehavior
  PlantBehaviorFactory --> BonusPlantBehavior
  PlantSpecSource <|.. DefaultPlantSpecSource
  DefaultPlantSpecSource --> PlantRepository
  PlantInstance --> PlantDefinition
  ZombieRepository <|.. ZombieRegistry
  ZombieRegistry o-- ZombieDefinition
  ZombieFactory --> ZombieDefinition
  ZombieFactory --> ZombieBehaviorFactory
  ZombieFactory --> ZombieInstance
  ZombieBehaviorFactory --> CompositeZombieBehavior
  CompositeZombieBehavior *-- ZombieAttackComponent
  CompositeZombieBehavior *-- ZombieMovementComponent
  CompositeZombieBehavior o-- ZombieSpecialAbility
  ZombieAttackComponent <|.. ArmoredRamZombieAttack
  ZombieSpecialAbility <|.. FishermanAbility
  ZombieSpecialAbility <|.. JesterAbility
  ZombieSpecialAbility <|.. WizardAbility
  ZombieSpecialAbility <|.. KingAbility
  ZombieInstance *-- ZombieAttackComponent
  ZombieInstance *-- ZombieMovementComponent
  ZombieSpecialSystem ..> FishermanAbility : mirrored tick rules
  ZombieSpecialSystem ..> WizardAbility : mirrored tick rules
  ZombieSpecialSystem ..> KingAbility : mirrored tick rules
  ZombieSpecSource <|.. DefaultZombieSpecSource
  DefaultZombieSpecSource --> ZombieRepository
  Board o-- PlantInstance
  SimulationWorld o-- ZombieInstance
}

package "Domain events, quests, and Travel Log" {
  class DomainEvent
  enum DomainEventType
  interface DomainEventListener
  class DomainEventBus
  class DomainEventPublisher
  class QuestCatalog
  class Quest
  class QuestInstance
  class QuestService
  class QuestRewardService
  enum TravelLogPage

  DomainEvent --> DomainEventType
  DomainEventBus o-- DomainEventListener
  DomainEventPublisher --> DomainEventBus
  QuestService ..|> DomainEventListener
  QuestService *-- QuestCatalog
  QuestCatalog o-- Quest
  QuestService --> QuestInstance
  QuestService *-- QuestRewardService
  TravelMenuController --> QuestService
  TravelMenuController --> TravelLogPage
  GameplayController --> DomainEventPublisher
  BoardController --> DomainEventPublisher
  ShopController --> DomainEventPublisher
  MiniGameController --> DomainEventPublisher
}

package "Minigame strategy framework" {
  class MiniGameCatalog
  class MiniGameDefinition
  class MiniGameLevelConfig
  abstract class MiniGame
  interface MiniGameCommandExtension
  class MiniGameSession
  class MiniGameService
  enum MiniGameId
  class VaseBreaker
  class BowlingWallnut
  class IZombie
  class Beghouled <<bonus>>
  class Zombotany <<bonus>>

  MiniGameCatalog *-- MiniGameDefinition
  MiniGameDefinition *-- MiniGameLevelConfig
  MiniGameDefinition --> MiniGameId
  MiniGame <|-- VaseBreaker
  MiniGame <|-- BowlingWallnut
  MiniGame <|-- IZombie
  MiniGame <|-- Beghouled
  MiniGame <|-- Zombotany
  MiniGame ..|> MiniGameCommandExtension
  MiniGameSession *-- MiniGameLevelConfig
  MiniGameSession --> Simulation
  MiniGameService *-- MiniGameCatalog
  MiniGameService --> MiniGameSession
  MiniGameController --> MiniGameService
  note right of MiniGameId
    Mandatory: Vase Breaker,
    Bowling Wall-nut, I, Zombie
    Bonus: Beghouled, Zombotany
  end note
}

package "Scored game (bonus) and leaderboard" {
  class ScoredGameService <<bonus>>
  class ScoredGameSession <<bonus>>
  class DailyZombieSequenceGenerator <<bonus>>
  class ScoredGameScore <<bonus>>
  enum ScorePattern <<bonus>>
  class Leaderboard
  class LeaderboardEntry
  enum LeaderboardColumn

  ScoredGameController --> ScoredGameService
  ScoredGameService --> ScoredGameSession
  ScoredGameService *-- DailyZombieSequenceGenerator
  ScoredGameSession --> Simulation
  ScoredGameSession --> ScoredGameScore
  ScoredGameScore --> ScorePattern
  LeaderboardService --> Leaderboard
  Leaderboard *-- LeaderboardEntry
  Leaderboard --> LeaderboardColumn
  LeaderboardService --> UserService
}

note bottom of App
  Composition root wires repositories, services,
  controllers, deterministic RNG, and injected Clock.
end note
@enduml
