  + begin(level: Level): Result<String>
  + showAllPlants(): Result<List<PlantDefinition>>
  + showAvailablePlants(): Result<List<PlantDefinition>>
  + addPlant(typeToken: String): Result<String>
  + removePlant(typeToken: String): Result<String>
  + boostPlant(typeToken: String): Result<String>
  + startGame(): Result<GameSession>
}

class GreenhouseBoostService {
  - userService: UserService
