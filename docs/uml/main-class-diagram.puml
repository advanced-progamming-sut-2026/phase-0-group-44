' MENU FRAMEWORK '

enum MenuName {
  REGISTER
  LOGIN
  MAIN
  GAME
  SETTINGS
  NETWORK
  NEWS
  PROFILE
  COLLECTION
  + getToken(): String
  + getDisplayName(): String
  + {static} fromToken(input: String): MenuName
}

class MenuGraph <<static>> {
  - {static} ENTRIES: Map<MenuName, Set<MenuName>>
  - {static} EXITS: Map<MenuName, MenuExit>
  + {static} reachableFrom(source: MenuName): Set<MenuName>
  + {static} canEnter(source: MenuName, destination: MenuName): boolean
  + {static} requiresAuthentication(source: MenuName, destination: MenuName): boolean
  + {static} exitOf(source: MenuName): MenuExit
}

class MenuExit {
  - kind: Kind
  - destination: MenuName
  + {static} returnTo(destination: MenuName): MenuExit
  + {static} terminate(): MenuExit
  + {static} forbidden(): MenuExit
}

enum MenuExit.Kind {
  RETURN_TO
  TERMINATE
  FORBIDDEN
}

class MenuController {
  - userService: UserService
  + enterMenu(menuName: String): Result<String>
  + showCurrentMenu(): Result<String>
