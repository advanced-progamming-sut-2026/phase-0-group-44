  + getSelectionRules(): LevelSelectionRules
}

class NormalLevel implements Level

class LevelSelectionRules {
  + {static} DEFAULT_CAPACITY: int = 8
  - capacity: int
  - allowedPlants: Set<PlantType>
  - selectionBypassed: boolean
  + {static} normal(): LevelSelectionRules
  + {static} withCapacity(capacity: int): LevelSelectionRules
  + {static} restrictedTo(capacity: int, allowed: Set<PlantType>): LevelSelectionRules
  + {static} bypassed(): LevelSelectionRules
  + allows(type: PlantType): boolean
}

class PlantSelection {
  - chosen: Set<PlantType>
  - diamondBoosted: Set<PlantType>
  + add(type: PlantType): boolean
  + remove(type: PlantType): boolean
  + contains(type: PlantType): boolean
  + isDiamondBoosted(type: PlantType): boolean
