@startuml
skinparam classAttributeIconSize 0


' APP / STORE / SERVICES / STORAGE '

class App {
  - store: Store
  - userRepository: UserRepository
  - userService: UserService
  - gameService: GameService
  - shop: Shop
  - leaderboard: Leaderboard
  + start()
  + changeMenu(menu: Menu)
  + logout()
}

class Store {
  - users: List<User>
  - currentUser: User
  - currentMenu: Menu
  - currentPlayer: Player
  - currentGameEngine: GameEngine
  - selectedLevel: Level
  - currentChapter: Chapter
  - activeMiniGame: MiniGame
  - chapters: List<Chapter>
  - newsItems: List<NewsItem>
  - quests: List<Quest>
  - shop: Shop
  - leaderboard: Leaderboard
  + getCurrentUser(): User
  + setCurrentUser(user: User)
  + getCurrentMenu(): Menu
  + setCurrentMenu(menu: Menu)
  + resetGameData()
}

interface UserRepository {
  + load(): SaveFile
  + save(saveFile: SaveFile)
  + quarantineCorruptSave(stamp: String): Path
  + getSaveFilePath(): Path
}

class JsonUserRepository implements UserRepository {
  - saveFilePath: Path
  - serializer: SaveSerializer
  - writer: AtomicFileWriter
}

' PERSISTENCE (serialization kept out of the domain) '

class SaveFile {
  + {static} CURRENT_VERSION: int
  - version: int
  - users: List<User>
  - lastLoggedInUsername: String
}

interface SaveSerializer {
  + serialize(saveFile: SaveFile): String
  + deserialize(content: String): SaveFile
}

class GsonSaveSerializer implements SaveSerializer {
  - gson: Gson
  - migrator: SaveFileMigrator
}

class SaveFileMigrator {
  + migrate(saveFile: SaveFile): SaveFile
}

class AtomicFileWriter {
  + write(target: Path, content: String)
}

SaveFile o-- User
JsonUserRepository --> SaveFile
JsonUserRepository --> SaveSerializer
JsonUserRepository --> AtomicFileWriter
GsonSaveSerializer --> SaveFileMigrator
SaveFileMigrator --> SaveFile

class UserService {
  - repository: UserRepository
  - clock: Clock
  + loadUsers(): Result<Integer>
  + saveUsers(): Result<String>
  + addUser(user: User): Result<String>
  + updateUser(user: User): Result<String>
  + getAutoLoginUser(): User
  + shutdown(): Result<String>
  + today(): LocalDate
  + login(username: String, password: String): User
  + logout()
  + changeUsername(user: User, username: String)
  + changeNickname(user: User, nickname: String)
  + changeEmail(user: User, email: String)
  + changePassword(user: User, oldPassword: String, newPassword: String)
  + changeDifficulty(user: User, level: int)
  + purchasePlant(user: User, type: PlantType)
  + upgradePlant(user: User, type: PlantType)
  + addNews(user: User, text: String)
  + showUnreadNews(user: User)
  + showAllNews(user: User)
  + getActiveQuests(user: User): List<Quest>
  + completeQuest(user: User, quest: Quest)
  + updateLeaderboard(user: User)
}

class GameService {
  - store: Store
  - userRepository: UserRepository
  + startGame(user: User, level: Level): GameEngine
  + finishGame(user: User, result: GameResult)
  + startMiniGame(user: User, miniGame: MiniGame)
  + finishMiniGame(user: User, result: GameResult)
}

